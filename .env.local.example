# Supabase — copy to .env.local and fill in from your project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy anon key also works if your project still uses it:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for admin media uploads (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local dev only — skip login without Supabase (never enable on Vercel production)
BYPASS_ADMIN_AUTH=true

# Site (optional overrides)
NEXT_PUBLIC_SITE_URL=https://www.elitebuildersco.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id
# NEXT_PUBLIC_SUPPORT_EMAIL=support@elitebuildersco.com

# Cloudflare Turnstile — optional CAPTCHA for contact/estimate forms (honeypot is always on)
# Create keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Dev test keys (always pass): site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
